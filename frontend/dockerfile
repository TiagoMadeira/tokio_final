# Stage 1: Build using Dev config
FROM node:22-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Force Vite to build using the development mode settings
# This ensures things like 'import.meta.env.DEV' are true
RUN npx vite build --mode development

# Stage 2: Serve via Nginx (to handle the /api proxy)
FROM nginx:stable-alpine
COPY default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]