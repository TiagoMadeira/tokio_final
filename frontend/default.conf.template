server {
    listen 80;
    absolute_redirect off;

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }

    # Proxy all /api requests to the backend pod
    location /api/ {
        # Internal K8s DNS works here because Nginx is inside the cluster
        proxy_pass ${API_URL}/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_redirect http:// https://;
    }

     # New OTLP proxy for traces
     location /v1/traces {
        proxy_pass  ${OTEL_EXPORTER_OTLP_ENDPOINT};
        proxy_set_header Content-Type "application/json";
        # You need these because the browser is sending a standard web request
        add_header 'Access-Control-Allow-Origin' '*';
        add_header 'Access-Control-Allow-Headers' 'content-type,traceparent';
    }
}