server {
    listen 8080;
    absolute_redirect off;

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }

    # Proxy all /api requests to the backend pod
    location /api/ {
        # Internal K8s DNS works here because Nginx is inside the cluster
        proxy_pass ${API_URL}/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # Forward the incoming trace ID from Playwright downstream
        proxy_set_header traceparent $http_traceparent;
        proxy_set_header tracestate $http_tracestate;
        proxy_set_header TRACEPARENT $http_traceparent;

        proxy_redirect http:// https://;
    }

     # New OTLP proxy for traces
     location /v1/traces {
        # Intercept CORS Preflight Options check
        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' '*' always;
            add_header 'Access-Control-Allow-Methods' 'POST, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'content-type,traceparent,tracestate' always;
            add_header 'Access-Control-Max-Age' 1728000 always;
            add_header 'Content-Type' 'text/plain; charset=utf-8' always;
            add_header 'Content-Length' 0 always;
            return 204;
        }
        proxy_pass  ${OTEL_EXPORTER_OTLP_ENDPOINT};
        proxy_set_header Content-Type "application/json";
        # You need these because the browser is sending a standard web request
        add_header 'Access-Control-Allow-Origin' '*' always;
         add_header 'Access-Control-Allow-Headers' 'content-type,traceparent,tracestate' always;
    }
}