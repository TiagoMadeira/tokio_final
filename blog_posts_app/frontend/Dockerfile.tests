# syntax=docker/dockerfile:1

FROM mcr.microsoft.com/playwright:v1.63.0-jammy

WORKDIR /app

# Keep npm install cached unless package.json/package-lock.json changes.
COPY package*.json ./

RUN --mount=type=cache,target=/root/.npm \
    npm ci

# Copy source/tests with the correct ownership.
COPY --chown=pwuser:pwuser . .

# Vitest/Vite writes temporary files into /app.
# Make sure pwuser owns the entire working directory.
RUN chown -R pwuser:pwuser /app

USER pwuser

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD node -e "require('fs').accessSync('.')"

CMD ["npm", "test"]
